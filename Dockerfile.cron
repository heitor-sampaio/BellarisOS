# Imagem do serviço de cron: só precisa de Node e do script disparador.
# Separada do Dockerfile principal de propósito — buildar o Next inteiro para
# rodar dois fetches por hora seria desperdício de minutos de build.
FROM node:22-alpine

WORKDIR /app

ENV TZ=America/Sao_Paulo

COPY scripts/cron.mjs ./cron.mjs

CMD ["node", "cron.mjs"]
