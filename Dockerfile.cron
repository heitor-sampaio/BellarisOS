# Imagem do serviço de cron: só precisa de Node e do script disparador.
#
# Separada do Dockerfile principal de propósito — buildar o Next inteiro para
# rodar dois fetches por hora gastaria minutos de build à toa.
#
# O CMD abaixo é quem manda; o serviço no Railway não precisa de start command.
FROM node:22-alpine

ENV TZ=America/Sao_Paulo

WORKDIR /app

COPY scripts/cron.mjs /app/cron.mjs

CMD ["node", "/app/cron.mjs"]
